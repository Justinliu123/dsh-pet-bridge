{
  "name": "dsh-pet",
  "version": "0.5.0",
  "description": "DSH 侧纯数据通道：把会话工作状态与通知通过本机 loopback 提供给桌面桌宠 exe（不含界面、不含余额、不含配置）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/index.test.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "desktop-pet",
    "data-channel"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.3": "compatible",
        "0.2.2-alpha.2": "compatible",
        "0.2.2-rc.1": "compatible"
      }
    }
  }
}
